# ==============================================================================
# Smart Land Analysis Platform - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and replace placeholder values with your real configuration.
# Never commit real credentials, passwords, or tokens to version control.

# Application Environment (development / staging / production / test)
APP_NAME="Smart Land Analysis Platform"
APP_ENV=development
DEBUG=True
API_V1_PREFIX=/api/v1

# Database Configuration (PostgreSQL / Supabase)
# Asyncpg driver string for FastAPI async queries:
DATABASE_URL=postgresql+asyncpg://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:<DB_PORT>/<DB_NAME>
# Psycopg2 driver string for Alembic sync migrations:
DATABASE_URL_SYNC=postgresql+psycopg2://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:<DB_PORT>/<DB_NAME>

# JWT Authentication
# IMPORTANT: Generate a strong random key (e.g., using `openssl rand -hex 32`)
JWT_SECRET_KEY=replace_with_a_secure_cryptographic_secret_key_minimum_32_characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Allowed Origins
# Comma-separated list of allowed frontend origins (no wildcards in production)
BACKEND_CORS_ORIGINS=http://localhost:5173,https://smart-land-analysis.vercel.app

# Report Generation Storage
REPORTS_DIR=generated_reports
